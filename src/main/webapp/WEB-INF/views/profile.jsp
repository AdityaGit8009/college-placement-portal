<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jsp" %>
<h1 class="page-title">Let your potential show.</h1><p class="page-subtitle">Your profile helps connect you with the right opportunities.</p><%if(role.equals("student")){%><div class="row g-4"><div class="col-xl-7"><div class="panel"><h2 class="section-title">Your details</h2><form action="<%=base%>/profile" method="post"><input type="hidden" name="csrf" value="<%=Security.html(session.getAttribute("csrf"))%>"><div class="mb-3"><label for="name" class="form-label">Full name</label><input class="form-control" id="name" name="name" value="<%=Security.html(user.get("name"))%>" required minlength="2" maxlength="80"></div><div class="row"><div class="col-md-6 mb-3"><label for="branch" class="form-label">Branch code</label><input class="form-control" id="branch" name="branch" placeholder="CSE" value="<%=Security.html(user.get("branch"))%>" required minlength="2" maxlength="80"></div><div class="col-md-6 mb-3"><label for="cgpa" class="form-label">CGPA</label><input class="form-control" id="cgpa" name="cgpa" type="number" min="0" max="10" step="0.01" value="<%=Security.html(user.get("cgpa"))%>" required></div></div><div class="mb-4"><label for="skills" class="form-label">Skills</label><textarea class="form-control" id="skills" name="skills" rows="4" maxlength="1000"><%=Security.html(user.get("skills"))%></textarea></div><button class="btn btn-primary">Save profile</button></form></div></div><div class="col-xl-5"><div class="panel"><span class="eyebrow text-purple">MAKE A FIRST IMPRESSION</span><h2 class="section-title mt-3">Your resume</h2><p class="text-secondary">Upload a PDF, up to 5 MB. Only you, the placement officer and recruiters whose jobs you applied for can download it.</p><form action="<%=base%>/resume" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="<%=Security.html(session.getAttribute("csrf"))%>"><label class="form-label" for="file">Resume PDF</label><input class="form-control mb-3" id="file" name="file" type="file" accept="application/pdf,.pdf" required><button class="btn btn-primary">Upload resume</button></form><a class="btn btn-outline-primary mt-3" href="<%=base%>/resume">Download current resume</a><p class="small text-secondary mt-4">Complete your branch, CGPA and resume before applying. Eligibility is verified on the server.</p></div></div></div><%}else{%><div class="panel">Your account: <%=Security.html(user.get("email"))%> · <%=Security.html(role)%></div><%}%>
<%@ include file="footer.jsp" %>
